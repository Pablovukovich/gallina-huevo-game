ributions":{},"includedScopes":[]},{"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":37,"line":35,"offset":734},"start":{"column":13,"line":35,"offset":710}},"value":{"id":"490e9d1e-77de-4eb3-b816-f85be64bad3b","metadata":[],"name":"nuevaPosicion","scope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"contributions":{},"includedScopes":[]},{"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":37,"line":35,"offset":734},"start":{"column":24,"line":35,"offset":721}}},"variable":{"id":"e1772d6e-e63b-47fe-8d81-37a4c151ed9d","metadata":[],"name":"position","scope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"contributions":{},"includedScopes":[]},{"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":21,"line":35,"offset":718},"start":{"column":13,"line":35,"offset":710}}}}],"sourceMap":{"end":{"column":10,"line":36,"offset":745},"start":{"column":61,"line":34,"offset":695}}}}],"sourceMap":{"end":{"column":6,"line":37,"offset":752},"start":{"column":29,"line":32,"offset":580}}},"compiled":false,"id":"7215a29d-b5eb-4999-b667-05751e269f4a","isOverride":false,"metadata":[],"name":"mover","parameters":[{"id":"5b56e709-9ae1-4b13-a538-0a8caad53609","isVarArg":false,"metadata":[],"name":"direccion","scope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"contributions":{},"includedScopes":[]},{"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":27,"line":32,"offset":578},"start":{"column":18,"line":32,"offset":569}}}],"problems":[],"scope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"contributions":{},"includedScopes":[]},{"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":6,"line":37,"offset":752},"start":{"column":5,"line":32,"offset":556}}}],"metadata":[{"args":{"position":"end","text":"/*\r\nclass Gallina {\r\n    var property position = 0 @ 0\r\n    var tieneHuevo = false\r\n    var cantidadAlimento = 0\r\n\r\n    method image() = \"gallina.png\"\r\n    method tieneHuevo() = tieneHuevo\r\n    method cantidadAlimento() = cantidadAlimento\r\n\r\n    method comer() {\r\n        cantidadAlimento += 1\r\n        self.convertirAlimento()\r\n    }\r\n\r\n    method convertirAlimento() {\r\n        if (cantidadAlimento >= 5) {\r\n            cantidadAlimento = 0\r\n            tieneHuevo = true\r\n        }\r\n    }\r\n\r\n    method retirarHuevo() {\r\n        tieneHuevo = false\r\n    }\r\n}\r\n\r\nconst gallinas = [\r\n    new Gallina(),\r\n    new Gallina(),\r\n    new Gallina(),\r\n    new Gallina(),\r\n    new Gallina()\r\n]\r\n\r\nobject corral {\r\n    method posicionDentroDelTablero(unaPosicion) =\r\n        unaPosicion.x() >= 0 && unaPosicion.x() < 25 &&\r\n        unaPosicion.y() >= 0 && unaPosicion.y() < 15\r\n\r\n    method estaEnGranero(unaPosicion) =\r\n        unaPosicion.x() >= 10 && unaPosicion.x() <= 14 &&\r\n        unaPosicion.y() >= 1 && unaPosicion.y() <= 2\r\n\r\n    method posicionOcupada(unaPosicion, ubicadas) =\r\n        ubicadas.any { gallina => gallina.position() == unaPosicion }\r\n\r\n    method posicionValida(unaPosicion, ubicadas) =\r\n        !self.estaEnGranero(unaPosicion) &&\r\n        !self.posicionOcupada(unaPosicion, ubicadas) &&\r\n        unaPosicion != granjero.position()\r\n\r\n    method posicionAleatoria() =\r\n        0.randomUpTo(24) @ 0.randomUpTo(14)\r\n\r\n    method ubicarGallina(unaGallina, ubicadas) {\r\n        var nuevaPosicion = self.posicionAleatoria()\r\n        while (!self.posicionValida(nuevaPosicion, ubicadas)) {\r\n            nuevaPosicion = self.posicionAleatoria()\r\n        }\r\n        unaGallina.position(nuevaPosicion)\r\n    }\r\n\r\n    method distribuirGallinas() {\r\n        const ubicadas = []\r\n        gallinas.forEach { gallina =>\r\n            self.ubicarGallina(gallina, ubicadas)\r\n            ubicadas.add(gallina)\r\n        }\r\n    }\r\n\r\n    method alimentarGallinasCercanas() {\r\n        gallinas.forEach { gallina => granjero.alimentar(gallina) }\r\n    }\r\n\r\n    method recolectarHuevosCercanos() {\r\n        gallinas.forEach { gallina => granjero.tomarHuevo(gallina) }\r\n    }\r\n}\r\n\r\nprogram juego {\r\n    game.title(\"Hay que poner un poco mas de huevo!\")\r\n    game.width(25)\r\n    game.height(15)\r\n    game.boardGround(\"granja.jpeg\")\r\n\r\n    corral.distribuirGallinas()\r\n    game.addVisual(granjero)\r\n    gallinas.forEach { gallina => game.addVisual(gallina) }\r\n\r\n    keyboard.up().onPressDo { granjero.mover(0 @ -1) }\r\n    keyboard.down().onPressDo { granjero.mover(0 @ 1) }\r\n    keyboard.left().onPressDo { granjero.mover(-1 @ 0) }\r\n    keyboard.right().onPressDo { granjero.mover(1 @ 0) }\r\n    keyboard.a().onPressDo { corral.alimentarGallinasCercanas() }\r\n    keyboard.e().onPressDo { corral.recolectarHuevosCercanos() }\r\n\r\n    game.start()\r\n}\r\n\r\n*/"},"name":"comment"},{"args":{"position":"inner","text":"/*\r\n    method estaCercaDe(unaGallina) {\r\n        const distanciaX = (position.x() - unaGallina.position().x()).abs()\r\n        const distanciaY = (position.y() - unaGallina.position().y()).abs()\r\n        return distanciaX + distanciaY == 1\r\n    }\r\n\r\n    method alimentar(unaGallina) {\r\n        if (comida > 0 && self.estaCercaDe(unaGallina) && !unaGallina.tieneHuevo()) {\r\n            comida -= 1\r\n            unaGallina.comer()\r\n        }\r\n    }\r\n\r\n    method tomarHuevo(unaGallina) {\r\n        if (self.estaCercaDe(unaGallina) && unaGallina.tieneHuevo()) {\r\n            cantidadDeHuevos += 1\r\n            unaGallina.retirarHuevo()\r\n        }\r\n    }\r\n    */"},"name":"comment"}],"name":"granjero","problems":[{"code":"malformedMember","sourceMap":{"end":{"column":26,"line":23,"offset":338},"start":{"column":23,"line":23,"offset":335}}}],"scope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"contributions":{},"includedScopes":[]},{"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"sourceMap":{"end":{"column":2,"line":59,"offset":1418},"start":{"column":1,"line":22,"offset":294}},"supertypes":[]},"stack":"Error: Failed to print, found malformed node\n    at c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:68:3585\n    at Ybn (c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:68:3396)\n    at c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:2430:847\n    at c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:2430:8440\n    at c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:37:74770\n    at Ke (c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:7:8527)\n    at It (c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:7:6189)\n    at et (c:\\Users\\Pol\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:7:6378)\n    at Immediate._onImmediate (c:\\Users\\Pol\\.vscode\\extensions\\uqb