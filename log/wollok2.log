ar cantidadAlimento = 0\r\n\r\n    method image() = \"gallina.png\"\r\n    method tieneHuevo() = tieneHuevo\r\n    method cantidadAlimento() = cantidadAlimento\r\n\r\n    method comer() {\r\n        cantidadAlimento += 1\r\n        self.convertirAlimento()\r\n    }\r\n\r\n    method convertirAlimento() {\r\n        if (cantidadAlimento >= 5) {\r\n            cantidadAlimento = 0\r\n            tieneHuevo = true\r\n        }\r\n    }\r\n\r\n    method retirarHuevo() {\r\n        tieneHuevo = false\r\n    }\r\n}\r\n\r\nconst gallinas = [\r\n    new Gallina(),\r\n    new Gallina(),\r\n    new Gallina(),\r\n    new Gallina(),\r\n    new Gallina()\r\n]\r\n\r\nobject corral {\r\n    method posicionDentroDelTablero(unaPosicion) =\r\n        unaPosicion.x() >= 0 && unaPosicion.x() < 25 &&\r\n        unaPosicion.y() >= 0 && unaPosicion.y() < 15\r\n\r\n    method estaEnGranero(unaPosicion) =\r\n        unaPosicion.x() >= 10 && unaPosicion.x() <= 14 &&\r\n        unaPosicion.y() >= 1 && unaPosicion.y() <= 2\r\n\r\n    method posicionOcupada(unaPosicion, ubicadas) =\r\n        ubicadas.any { gallina => gallina.position() == unaPosicion }\r\n\r\n    method posicionValida(unaPosicion, ubicadas) =\r\n        !self.estaEnGranero(unaPosicion) &&\r\n        !self.posicionOcupada(unaPosicion, ubicadas) &&\r\n        unaPosicion != granjero.position()\r\n\r\n    method posicionAleatoria() =\r\n        0.randomUpTo(24) @ 0.randomUpTo(14)\r\n\r\n    method ubicarGallina(unaGallina, ubicadas) {\r\n        var nuevaPosicion = self.posicionAleatoria()\r\n        while (!self.posicionValida(nuevaPosicion, ubicadas)) {\r\n            nuevaPosicion = self.posicionAleatoria()\r\n        }\r\n        unaGallina.position(nuevaPosicion)\r\n    }\r\n\r\n    method distribuirGallinas() {\r\n        const ubicadas = []\r\n        gallinas.forEach { gallina =>\r\n            self.ubicarGallina(gallina, ubicadas)\r\n            ubicadas.add(gallina)\r\n        }\r\n    }\r\n\r\n    method alimentarGallinasCercanas() {\r\n        gallinas.forEach { gallina => granjero.alimentar(gallina) }\r\n    }\r\n\r\n    method recolectarHuevosCercanos() {\r\n        gallinas.forEach { gallina => granjero.tomarHuevo(gallina) }\r\n    }\r\n}\r\n\r\nprogram juego {\r\n    game.title(\"Hay que poner un poco mas de huevo!\")\r\n    game.width(25)\r\n    game.height(15)\r\n    game.boardGround(\"granja.jpeg\")\r\n\r\n    corral.distribuirGallinas()\r\n    game.addVisual(granjero)\r\n    gallinas.forEach { gallina => game.addVisual(gallina) }\r\n\r\n    keyboard.up().onPressDo { granjero.mover(0 @ -1) }\r\n    keyboard.down().onPressDo { granjero.mover(0 @ 1) }\r\n    keyboard.left().onPressDo { granjero.mover(-1 @ 0) }\r\n    keyboard.right().onPressDo { granjero.mover(1 @ 0) }\r\n    keyboard.a().onPressDo { corral.alimentarGallinasCercanas() }\r\n    keyboard.e().onPressDo { corral.recolectarHuevosCercanos() }\r\n\r\n    game.start()\r\n}\r\n\r\n*/"},"name":"comment"},{"args":{"position":"inner","text":"/*\r\n    method estaCercaDe(unaGallina) {\r\n        const distanciaX = (position.x() - unaGallina.position().x()).abs()\r\n        const distanciaY = (position.y() - unaGallina.position().y()).abs()\r\n        return distanciaX + distanciaY == 1\r\n    }\r\n\r\n    method alimentar(unaGallina) {\r\n        if (comida > 0 && self.estaCercaDe(unaGallina) && !unaGallina.tieneHuevo()) {\r\n            comida -= 1\r\n            unaGallina.comer()\r\n        }\r\n    }\r\n\r\n    method tomarHuevo(unaGallina) {\r\n        if (self.estaCercaDe(unaGallina) && unaGallina.tieneHuevo()) {\r\n            cantidadDeHuevos += 1\r\n            unaGallina.retirarHuevo()\r\n        }\r\n    }\r\n    */"},"name":"comment"}],"name":"granjero","problems":[{"code":"malformedMember","sourceMap":{"end":{"column":26,"line":23,"offset":339},"start":{"column":23,"line":23,"offset":336}}}],"scope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedSco